<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
	<core xmlns="urn:activemq:core">
		<acceptors>
			<acceptor name="invm">vm://0</acceptor>
		</acceptors>
		<security-enabled>false</security-enabled>
		<persistence-enabled>false</persistence-enabled>
		<address-settings>
			<address-setting match="qdist014">
				<dead-letter-address>qdist015Bq</dead-letter-address>
				<expiry-address>qdist015Bq</expiry-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
		</address-settings>

		<addresses>
			<address name="qdist015Bq">
				<anycast>
					<queue name="qdist015Bq"/>
				</anycast>
			</address>
			<address name="qdist015FunksjonellFeil">
				<anycast>
					<queue name="qdist015FunksjonellFeil"/>
				</anycast>
			</address>
			<address name="qdist015">
				<anycast>
					<queue name="qdist015"/>
				</anycast>
			</address>
			<address name="qdist009">
				<anycast>
					<queue name="qdist009"/>
				</anycast>
			</address>
		</addresses>
	</core>
</configuration>